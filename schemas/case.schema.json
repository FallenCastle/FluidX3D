        "trt_magic_parameter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "smagorinsky_constant"
            ]
          },
          "then": {
            "properties": {
              "turbulence": {
                "const": "smagorinsky"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "trt_magic_parameter"
            ]
          },
          "then": {
            "properties": {
              "collision": {
                "const": "TRT"
              }
            },
            "required": [
              "collision"
            ]
          }
        }
      ]
    },
    "units": {
      "type": "object",
