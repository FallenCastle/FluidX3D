      "required": [],
      "additionalProperties": false
    },
    "fluid": {
      "type": "object",
      "properties": {
        "rho": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reynolds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_velocity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "body_force": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "rho"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "nu"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "reynolds"
                ]
              },
              {
                "required": [
                  "reference_length"
                ]
              },
              {
                "required": [
                  "reference_velocity"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "reynolds",
            "reference_length",
            "reference_velocity"
          ],
          "not": {
            "required": [
              "nu"
            ]
          }
        }
      ]
    },
    "initial": {
      "type": "object",
      "properties": {
        "rho": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "velocity": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "box_min": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "box_max": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rho": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "velocity": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "box_min",
              "box_max",
              "rho",
              "velocity"
