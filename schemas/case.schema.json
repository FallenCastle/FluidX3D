                "required": [
                  "size",
                  "center"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "factor"
                      ]
                    },
                    {
                      "required": [
                        "pivot"
                      ]
                    },
                    {
                      "required": [
                        "translation"
                      ]
                    }
                  ]
                }
              },
              {
                "properties": {
                  "mode": {
                    "const": "scale"
                  }
                },
                "required": [
                  "factor",
                  "translation"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "size"
                      ]
                    },
                    {
                      "required": [
                        "center"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "file",
          "transform"
        ],
        "additionalProperties": false
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
