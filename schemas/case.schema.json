            "type": "number",
            "exclusiveMinimum": 0
          },
          "velocity": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "id",
          "faces",
          "type"
