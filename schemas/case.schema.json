            },
            "then": {
              "required": [
                "rho",
                "velocity"
              ]
            },
            "else": {
              "if": {
                "properties": {
                  "type": {
                    "const": "moving_wall"
                  }
                }
              },
              "then": {
                "required": [
                  "velocity"
                ],
                "not": {
                  "required": [
                    "rho"
                  ]
                }
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "rho"
                      ]
                    },
                    {
                      "required": [
                        "velocity"
                      ]
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "periodic"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "region"
                ]
              }
            }
          }
        ]
      }
