                  "required": [
                    "memory_budget_mb"
                  ]
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "units": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reference_density"
                  ]
                },
                {
                  "required": [
                    "dt"
                  ]
                },
                {
                  "required": [
                    "reference_velocity"
                  ]
                },
                {
                  "required": [
                    "lattice_velocity"
                  ]
                }
              ]
            }
          },
          "domain": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "length"
                  ]
                },
                {
                  "required": [
                    "dx"
                  ]
                }
              ]
            },
            "oneOf": [
              {
                "required": [
                  "cells"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "aspect_ratio"
                      ]
                    },
                    {
                      "required": [
                        "memory_budget_mb"
                      ]
                    }
                  ]
