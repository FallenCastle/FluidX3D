{
  "schema_version": 1,
  "case": { "name": "thermal-natural-convection-conductive-wall-lattice" },
  "solver": { "lattice": "D3Q27", "collision": "TRT", "storage": "FP32", "turbulence": "none" },
  "physics": {
    "gravity": [0, -0.0006103515625, 0],
    "thermal": {
      "reference_temperature": 1.0,
      "initial_temperature": 1.0,
      "specific_heat": 1.0,
      "conductivity": 0.02,
      "thermal_expansion": 0.1,
      "materials": [
        {
          "id": "conductive-wall",
          "density": 2.0,
          "specific_heat": 1.0,
          "conductivity": 0.08,
          "heat_source": 0.0,
          "initial_temperature": 1.0
        }
      ]
    }
  },
  "units": { "mode": "lattice" },
  "domain": { "cells": [40, 36, 4] },
  "fluid": { "rho": 1.0, "nu": 0.02 },
  "initial": { "velocity": [0, 0, 0] },
  "geometry": [
    {
      "id": "inner-conductive-wall",
      "file": "assets/thin-plate-1x16x2-binary.stl",
      "material": "conductive-wall",
      "transform": { "mode": "fit", "size": 32.0, "center": [3.0, 18.0, 2.0] }
    }
  ],
  "boundaries": [
    {
      "id": "hot",
      "faces": ["xmin"],
      "type": "no_slip",
      "thermal": { "type": "fixed_temperature", "temperature": 1.1 }
    },
    {
      "id": "cold",
      "faces": ["xmax"],
      "type": "no_slip",
      "thermal": { "type": "fixed_temperature", "temperature": 0.9 }
    },
    {
      "id": "adiabatic-horizontal",
      "faces": ["ymin", "ymax"],
      "type": "no_slip",
      "thermal": { "type": "adiabatic" }
    },
    { "id": "periodic-depth", "faces": ["zmin", "zmax"], "type": "periodic" }
  ],
  "run": { "steps": 1000, "monitor_every": 100 },
  "output": { "vtk_fields": ["T", "material", "u"], "vtk_every": 1000, "initial": true }
}
