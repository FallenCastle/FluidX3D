{
  "schema_version": 1,
  "case": { "name": "thermal-free-surface-dynamic-cycle-lattice" },
  "solver": { "lattice": "D3Q27", "collision": "TRT", "storage": "FP32", "turbulence": "smagorinsky" },
  "physics": {
    "gravity": [0, 0, -0.00005],
    "thermal": {
      "reference_temperature": 1.0,
      "initial_temperature": 1.0,
      "specific_heat": 1.0,
      "conductivity": 0.025,
      "thermal_expansion": 0.01,
      "turbulent_prandtl": 0.9,
      "materials": [
        {
          "id": "heated-solid",
          "density": 2.0,
          "specific_heat": 1.0,
          "conductivity": 0.05,
          "heat_source": 0.00002,
          "initial_temperature": 1.2
        }
      ]
    },
    "free_surface": { "surface_tension": 0.0005, "environment_pressure": 0 }
  },
  "units": { "mode": "lattice" },
  "domain": { "cells": [36, 24, 28] },
  "fluid": { "rho": 1.0, "nu": 0.06 },
  "initial": {
    "velocity": [0, 0, 0],
    "liquid_regions": [
      { "box_min": [1, 1, 1], "box_max": [34.999, 22.999, 14.0] }
    ]
  },
  "geometry": [
    {
      "id": "heated-oscillator",
      "file": "assets/unit-cube-binary.stl",
      "material": "heated-solid",
      "contact_angle": 75,
      "transform": { "mode": "fit", "size": 5.0, "center": [18, 12, 15] },
      "motion": {
        "translation": { "type": "sinusoidal", "amplitude": [0, 0, 3], "period": 480 },
        "rotation": {
          "type": "sinusoidal",
          "axis": [0, 1, 0],
          "amplitude_degrees": 8,
          "period": 480
        }
      }
    }
  ],
  "boundaries": [
    {
      "id": "walls",
      "faces": ["xmin", "xmax", "ymin", "ymax", "zmin", "zmax"],
      "type": "no_slip",
      "contact_angle": 90,
      "thermal": { "type": "adiabatic" }
    }
  ],
  "run": { "steps": 480, "monitor_every": 40 },
  "output": {
    "vtk_fields": ["object", "material", "T", "phi", "flags", "u", "rho"],
    "vtk_every": 80,
    "initial": true
  }
}
